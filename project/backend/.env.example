# ========================================
# TIKRI JUNCTION — PARTNER BACKEND CONFIG
# Copy this file to .env and fill values
# ========================================

# Server Config
PORT=3001
NODE_ENV=development

# Fast2SMS API Key (Get FREE from https://www.fast2sms.com)
# Sign up → Dashboard → Dev API → Copy API Key
FAST2SMS_API_KEY=your_fast2sms_api_key_here

# OTP Config
OTP_EXPIRY_SECONDS=120
OTP_LENGTH=4

# CORS — the URL of your frontend (local file or hosted)
ALLOWED_ORIGIN=*
