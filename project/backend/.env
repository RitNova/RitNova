# ========================================
# TIKRI JUNCTION — PARTNER BACKEND CONFIG
# ========================================

PORT=3001
NODE_ENV=development
OTP_EXPIRY_SECONDS=120
OTP_LENGTH=4

# ── OPTION 1: TWILIO (Recommended - Free $15 trial, real SMS)
# Sign up FREE: https://www.twilio.com/try-twilio
# Dashboard → Account SID + Auth Token + Buy a number (free on trial)
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_FROM_NUMBER=+1XXXXXXXXXX

# ── OPTION 2: FAST2SMS (Needs ₹100 recharge to activate API)
# Sign up: https://www.fast2sms.com
FAST2SMS_API_KEY=zrhvaqI80bNXwH5AZ9UCxWdmoE3ckQ4sDeTyP7iSL1FYfgOp2MXIkwLvgrFneVWasP1x7Rl9cACBijZf

# ── OPTION 3: DEV MODE (default — OTP shown on screen, no SMS)
# If neither Twilio nor Fast2SMS is configured, OTP will appear on screen.
